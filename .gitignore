# bytecode / caches
__pycache__/
*.pyc
*.pyo

# matplotlib / preview outputs
/tmp/

# local UMAP cache (regenerated by scripts/fig4_universal_psops.py on first run)
_cache_umap.npz

# other regenerated computation caches (rebuilt by the repro scripts on first run)
caches/cache_*.npz
caches/*_cache.npz

# internal autonomous-session work log (not part of the published repro)
AUTONOMOUS_LOG.md

# generated table fragments (regenerated by scripts/table4_chow_ranks.py)
tables/

# do NOT ignore figures/ -- the paper points at the PDFs in there
# Computation caches SHIP with the repo: they turn a multi-hour cold rebuild
# into a ~30 s make_figures.py run, and cache_dmap_ablation_dv.npz is not
# rebuildable without the raw corpus. Negations below override the legacy
# cache ignore patterns above.
!caches/_cache_phillips_coupling.npz
!caches/_cache_velocity_moments.pkl
!caches/_cache_umap_coords.npz
!caches/cache_dysts_costs.npz
!caches/cache_dysts_features.npz
!caches/cache_dmap_ablation_dv.npz
!artifacts/robustness_cache.npz
!dysts_plan_metrics.npz
# transport-plan binaries exceed GitHub's limits; deposited on Zenodo at
# release. make_figures.py does not need them; only --recompute paths and
# pipeline/compute_dimensions.py do.
artifacts/plans.dat
artifacts/sqrtplans.dat
artifacts/plans_dist.dat
artifacts/sqrtplans_dist.dat

